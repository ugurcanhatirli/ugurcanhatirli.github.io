---
import { getCollection, render } from 'astro:content';
import ProseLayout from '../../layouts/ProseLayout.astro';
import {
  publishedOnly,
  assertUniqueUrlSlugs,
  titleCase,
  formatWrittenDate,
  formatDate,
} from '../../lib/content';
import { SUBJECT_LABELS } from '../../lib/subjects';
import { strings } from '../../lib/strings';

export async function getStaticPaths() {
  const entries = publishedOnly(await getCollection('notes'));
  assertUniqueUrlSlugs('notes', entries);
  return entries.map((entry) => ({
    params: { urlSlug: entry.data.urlSlug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const subjectLabels = entry.data.subjects.map((id) => SUBJECT_LABELS[id]).join(', ');
---

<ProseLayout
  title={entry.data.title}
  description={entry.data.description}
  lang={entry.data.lang}
  publishedDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
>
  <p class="meta" slot="meta" lang="en">
    {
      entry.data.writtenDate && (
        <>
          Written{' '}
          <time datetime={entry.data.writtenDate}>
            {formatWrittenDate(entry.data.writtenDate, entry.data.lang)}
          </time>
          {' '}·{' '}
        </>
      )
    }
    Published <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate, entry.data.lang)}</time>
    {
      entry.data.updatedDate && (
        <>
          {' '}
          · Updated{' '}
          <time datetime={entry.data.updatedDate.toISOString()}>{formatDate(entry.data.updatedDate, entry.data.lang)}</time>
        </>
      )
    }
    {' '}· {entry.data.lang.toUpperCase()} · {titleCase(entry.data.noteType)}
    {' '}· {subjectLabels}
  </p>
  <Content />
  <p class="meta" lang="en">{strings.fallibility}</p>
  <p class="meta" lang="en"><a href="/notes/">← Back to Notes</a></p>
</ProseLayout>
