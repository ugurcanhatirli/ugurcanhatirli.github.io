---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedOnly, titleCase, formatDate, compareByPubDateDesc } from '../../lib/content';
import { strings } from '../../lib/strings';
import { SUBJECT_LABELS } from '../../lib/subjects';

const entries = publishedOnly(await getCollection('writing')).sort(compareByPubDateDesc);
---

<BaseLayout title={strings.nav.writing} description={strings.descriptions.writing}>
  <h1>{strings.nav.writing}</h1>
  <ul class="entry-list">
    {
      entries.map((entry) => (
        <li>
          <a href={`/writing/${entry.data.urlSlug}/`} lang={entry.data.lang}>
            {entry.data.title}
          </a>
          <p class="meta" lang="en">
            <time datetime={entry.data.pubDate.toISOString()}>
              {formatDate(entry.data.pubDate, entry.data.lang)}
            </time>{' '}
            · {entry.data.lang.toUpperCase()}
            {entry.data.kind !== 'essay' && <>{' '}· {titleCase(entry.data.kind)}</>}
            {' '}·{' '}
            {entry.data.subjects.map((id) => SUBJECT_LABELS[id]).join(', ')}
          </p>
          <p lang={entry.data.lang}>{entry.data.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
