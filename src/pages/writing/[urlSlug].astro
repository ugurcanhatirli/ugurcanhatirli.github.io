---
import { getCollection, render } from 'astro:content';
import ProseLayout from '../../layouts/ProseLayout.astro';
import { publishedOnly, assertUniqueUrlSlugs, titleCase, formatDate } from '../../lib/content';
import { SUBJECT_LABELS } from '../../lib/subjects';
import { strings } from '../../lib/strings';

export async function getStaticPaths() {
  const entries = publishedOnly(await getCollection('writing'));
  assertUniqueUrlSlugs('writing', entries);
  return entries.map((entry) => ({
    params: { urlSlug: entry.data.urlSlug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const subjectLabels = entry.data.subjects.map((id) => SUBJECT_LABELS[id]).join(', ');
---

<ProseLayout
  title={entry.data.title}
  description={entry.data.description}
  lang={entry.data.lang}
  publishedDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
>
  <p class="meta" slot="meta" lang="en">
    Published <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate, entry.data.lang)}</time>
    {
      entry.data.updatedDate && (
        <>
          {' '}
          · Revised{' '}
          <time datetime={entry.data.updatedDate.toISOString()}>{formatDate(entry.data.updatedDate, entry.data.lang)}</time>
        </>
      )
    }
    {' '}· {entry.data.lang.toUpperCase()}
    {entry.data.kind !== 'essay' && <>{' '}· {titleCase(entry.data.kind)}</>}
    {' '}· {subjectLabels}
  </p>
  <Content />
  {
    entry.data.kind === 'essay' && (
      <p class="meta" lang="en">{strings.fallibility}</p>
    )
  }
  <p class="meta" lang="en"><a href="/writing/">← Back to Writing</a></p>
</ProseLayout>
